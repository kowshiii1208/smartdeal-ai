# Environment Configuration Example for SmartDeal AI
# Copy this file to .env and configure as needed.

# Application Environment (development, production)
APP_ENV=development

# Optional External Retailer API Keys (Leave blank for Demo Mode)
AMAZON_PRODUCT_API_KEY=
AMAZON_API_SECRET=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Database Settings (Default is local SQLite)
DATABASE_URL=sqlite:///database/smartdeal.db

# Random Seed for Reproducibility
RANDOM_SEED=42
